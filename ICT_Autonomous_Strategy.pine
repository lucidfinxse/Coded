// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// © ICT Pure Concepts - Autonomous Execution Engine
//@version=6
strategy("ICT Sniper v6", overlay=true, margin_long=100, margin_short=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=2,
     pyramiding=1, calc_on_every_tick=true, process_orders_on_close=false,
     max_bars_back=500, fill_orders_on_standard_ohlc=true)

// ============================================================================
// INPUTS
// ============================================================================

grp_kz  = "Kill Zones"
useKZ   = input.bool(false, "Only Trade Kill Zones", group=grp_kz, tooltip="OFF = trade anytime for max frequency")
ldnKZ   = input.session("0200-0500", "London KZ", group=grp_kz)
nyKZ    = input.session("0700-1000", "New York KZ", group=grp_kz)
ldnClKZ = input.session("1000-1200", "London Close KZ", group=grp_kz)
asianSS = input.session("2000-0000", "Asian Session", group=grp_kz)

grp_ms  = "Market Structure"
swingLen = input.int(3, "Swing Length", minval=1, maxval=20, group=grp_ms)

grp_ob  = "Order Blocks"
obMaxAge = input.int(80, "OB Max Age (bars)", minval=5, maxval=300, group=grp_ob)

grp_fvg = "Fair Value Gaps"
fvgMaxAge = input.int(60, "FVG Max Age (bars)", minval=5, maxval=200, group=grp_fvg)

grp_ote = "Optimal Trade Entry"
oteFibHi = input.float(0.79, "OTE Upper Fib", minval=0.5, maxval=0.95, step=0.01, group=grp_ote)
oteFibLo = input.float(0.62, "OTE Lower Fib", minval=0.5, maxval=0.95, step=0.01, group=grp_ote)

grp_risk = "Risk Management"
rr       = input.float(3.0, "Risk:Reward", minval=1.0, maxval=10.0, step=0.5, group=grp_risk)
useBE    = input.bool(true, "Move SL to Break-Even at 1R", group=grp_risk)
maxDaily = input.int(500, "Max Daily Trades", minval=1, maxval=1000, group=grp_risk)
maxBarsInTrade = input.int(60, "Max Bars in Trade (time exit)", minval=5, maxval=500, group=grp_risk)

grp_htf  = "HTF Bias"
htfTF    = input.timeframe("15", "HTF Timeframe", group=grp_htf)

grp_conf = "Confluence"
minScore = input.int(3, "Min Confluence (1-8)", minval=1, maxval=8, group=grp_conf, tooltip="3 = frequent trades with solid confluence. 5+ = sniper only.")

// ============================================================================
// ATR
// ============================================================================

atr = ta.atr(14)

// ============================================================================
// 1. KILL ZONES
// ============================================================================

inLDN    = not na(time(timeframe.period, ldnKZ, "America/New_York"))
inNY     = not na(time(timeframe.period, nyKZ, "America/New_York"))
inLDNcl  = not na(time(timeframe.period, ldnClKZ, "America/New_York"))
inAsian  = not na(time(timeframe.period, asianSS, "America/New_York"))
inKZ     = inLDN or inNY or inLDNcl
kzOK     = useKZ ? inKZ : true

// ============================================================================
// 2. ASIAN RANGE
// ============================================================================

var float asiaHi = na
var float asiaLo = na
var bool  asiaLocked = false

if inAsian
    if not inAsian[1]
        asiaHi := high
        asiaLo := low
        asiaLocked := false
    else
        asiaHi := math.max(asiaHi, high)
        asiaLo := math.min(asiaLo, low)

if inAsian[1] and not inAsian
    asiaLocked := true

asiaRaidHigh = asiaLocked and high > asiaHi and close < asiaHi
asiaRaidLow  = asiaLocked and low < asiaLo and close > asiaLo

// ============================================================================
// 3. MARKET STRUCTURE — BOS & CHoCH (MSS)
// ============================================================================

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSH    = na
var float lastSL    = na
var float prevSH    = na
var float prevSL    = na
var int   lastSHbar = 0
var int   lastSLbar = 0
var int   trend     = 0

if not na(swH)
    prevSH    := lastSH
    lastSH    := swH
    lastSHbar := bar_index - swingLen

if not na(swL)
    prevSL    := lastSL
    lastSL    := swL
    lastSLbar := bar_index - swingLen

bullBOS = not na(lastSH) and close > lastSH and trend == 1
bearBOS = not na(lastSL) and close < lastSL and trend == -1
bullMSS = not na(lastSH) and close > lastSH and trend == -1
bearMSS = not na(lastSL) and close < lastSL and trend == 1

if bullBOS or bullMSS
    trend := 1
if bearBOS or bearMSS
    trend := -1

// Wider recent window = more entries
recentBullMSS = bullMSS or bullMSS[1] or bullMSS[2] or bullMSS[3] or bullMSS[4] or bullMSS[5]
recentBearMSS = bearMSS or bearMSS[1] or bearMSS[2] or bearMSS[3] or bearMSS[4] or bearMSS[5]
recentBullBOS = bullBOS or bullBOS[1] or bullBOS[2] or bullBOS[3] or bullBOS[4] or bullBOS[5]
recentBearBOS = bearBOS or bearBOS[1] or bearBOS[2] or bearBOS[3] or bearBOS[4] or bearBOS[5]

// Either MSS or BOS counts as structure confirmation
structureBull = recentBullMSS or recentBullBOS
structureBear = recentBearMSS or recentBearBOS

// ============================================================================
// 4. DISPLACEMENT
// ============================================================================

bodySize = math.abs(close - open)
bullDisp = close > open and bodySize > atr * 1.0  // Lowered from 1.5 for more frequency
bearDisp = close < open and bodySize > atr * 1.0
recentBullDisp = bullDisp or bullDisp[1] or bullDisp[2] or bullDisp[3] or bullDisp[4] or bullDisp[5]
recentBearDisp = bearDisp or bearDisp[1] or bearDisp[2] or bearDisp[3] or bearDisp[4] or bearDisp[5]

// Track the sweep candle's extreme (for magnificent SL placement)
var float bullDispLow  = na  // Lowest point during recent bull displacement sequence
var float bearDispHigh = na  // Highest point during recent bear displacement sequence

if bullDisp
    bullDispLow := low
if bearDisp
    bearDispHigh := high

// ============================================================================
// 5. ORDER BLOCKS
// ============================================================================

var float bullOB_hi  = na
var float bullOB_lo  = na
var int   bullOB_bar = 0
var bool  bullOB_on  = false
var float bullOB_wick = na  // Track the full wick low of the OB candle

var float bearOB_hi  = na
var float bearOB_lo  = na
var int   bearOB_bar = 0
var bool  bearOB_on  = false
var float bearOB_wick = na  // Track the full wick high of the OB candle

if bullDisp and close[1] < open[1]
    bullOB_hi   := math.max(open[1], close[1])
    bullOB_lo   := math.min(open[1], close[1])
    bullOB_wick := low[1]  // The TRUE low — behind the wick is where SL hides
    bullOB_bar  := bar_index - 1
    bullOB_on   := true

if bearDisp and close[1] > open[1]
    bearOB_hi   := math.max(open[1], close[1])
    bearOB_lo   := math.min(open[1], close[1])
    bearOB_wick := high[1]  // The TRUE high — SL goes above this
    bearOB_bar  := bar_index - 1
    bearOB_on   := true

if bullOB_on and close < bullOB_lo
    bullOB_on := false
if bearOB_on and close > bearOB_hi
    bearOB_on := false

if bullOB_on and (bar_index - bullOB_bar) > obMaxAge
    bullOB_on := false
if bearOB_on and (bar_index - bearOB_bar) > obMaxAge
    bearOB_on := false

inBullOB = bullOB_on and low <= bullOB_hi and close >= bullOB_lo
inBearOB = bearOB_on and high >= bearOB_lo and close <= bearOB_hi

// ============================================================================
// 6. FAIR VALUE GAPS
// ============================================================================

var float bullFVG_hi  = na
var float bullFVG_lo  = na
var int   bullFVG_bar = 0
var bool  bullFVG_on  = false

var float bearFVG_hi  = na
var float bearFVG_lo  = na
var int   bearFVG_bar = 0
var bool  bearFVG_on  = false

if low > high[2] and (low - high[2]) > atr * 0.001
    bullFVG_hi  := low
    bullFVG_lo  := high[2]
    bullFVG_bar := bar_index - 1
    bullFVG_on  := true

if high < low[2] and (low[2] - high) > atr * 0.001
    bearFVG_hi  := low[2]
    bearFVG_lo  := high
    bearFVG_bar := bar_index - 1
    bearFVG_on  := true

if bullFVG_on and close < bullFVG_lo
    bullFVG_on := false
if bearFVG_on and close > bearFVG_hi
    bearFVG_on := false

if bullFVG_on and (bar_index - bullFVG_bar) > fvgMaxAge
    bullFVG_on := false
if bearFVG_on and (bar_index - bearFVG_bar) > fvgMaxAge
    bearFVG_on := false

inBullFVG = bullFVG_on and low <= bullFVG_hi and close >= bullFVG_lo
inBearFVG = bearFVG_on and high >= bearFVG_lo and close <= bearFVG_hi

// ============================================================================
// 7. LIQUIDITY SWEEPS
// ============================================================================

var float eqHiLvl  = na
var float eqLoLvl  = na
var bool  eqHiOn   = false
var bool  eqLoOn   = false

// Track sweep candle extremes for SL placement
var float sweepBullLow  = na  // The wick low of the candle that swept lows
var float sweepBearHigh = na  // The wick high of the candle that swept highs

if not na(swH) and not na(prevSH)
    tol = prevSH * 0.0005
    if math.abs(swH - prevSH) < tol
        eqHiLvl := math.max(swH, prevSH)
        eqHiOn  := true

if not na(swL) and not na(prevSL)
    tol = prevSL * 0.0005
    if math.abs(swL - prevSL) < tol
        eqLoLvl := math.min(swL, prevSL)
        eqLoOn  := true

bullSweep      = eqLoOn and low < eqLoLvl and close > eqLoLvl
bearSweep      = eqHiOn and high > eqHiLvl and close < eqHiLvl
swingSweepBull = not na(lastSL) and low < lastSL and close > lastSL
swingSweepBear = not na(lastSH) and high > lastSH and close < lastSH

liqSweptBull = bullSweep or swingSweepBull or asiaRaidLow
liqSweptBear = bearSweep or swingSweepBear or asiaRaidHigh

// Record the extreme of the sweep candle — this is THE key SL level
if liqSweptBull
    sweepBullLow := low  // The absolute low of the sweep = where smart money filled
if liqSweptBear
    sweepBearHigh := high

recentBullSweep = liqSweptBull or liqSweptBull[1] or liqSweptBull[2] or liqSweptBull[3] or liqSweptBull[4] or liqSweptBull[5]
recentBearSweep = liqSweptBear or liqSweptBear[1] or liqSweptBear[2] or liqSweptBear[3] or liqSweptBear[4] or liqSweptBear[5]

if bullSweep
    eqLoOn := false
if bearSweep
    eqHiOn := false

// ============================================================================
// 8. OPTIMAL TRADE ENTRY (OTE)
// ============================================================================

var bool inOTE_bull = false
var bool inOTE_bear = false

if not na(lastSH) and not na(lastSL) and lastSH > lastSL
    if trend == 1
        fib62 = lastSH - (lastSH - lastSL) * oteFibLo
        fib79 = lastSH - (lastSH - lastSL) * oteFibHi
        inOTE_bull := close <= fib62 and close >= fib79
        inOTE_bear := false
    else
        fib62 = lastSL + (lastSH - lastSL) * oteFibLo
        fib79 = lastSL + (lastSH - lastSL) * oteFibHi
        inOTE_bear := close >= fib62 and close <= fib79
        inOTE_bull := false
else
    inOTE_bull := false
    inOTE_bear := false

// ============================================================================
// 9. PREMIUM / DISCOUNT
// ============================================================================

pdHi        = ta.highest(high, 30)
pdLo        = ta.lowest(low, 30)
equilibrium = (pdHi + pdLo) / 2
inDiscount  = close < equilibrium
inPremium   = close > equilibrium

// ============================================================================
// 10. BREAKER BLOCKS
// ============================================================================

var float bullBrk_hi = na
var float bullBrk_lo = na
var bool  bullBrk_on = false
var float bearBrk_hi = na
var float bearBrk_lo = na
var bool  bearBrk_on = false

if bearOB_on[1] and not bearOB_on and high > bearOB_hi[1]
    bullBrk_hi := bearOB_hi[1]
    bullBrk_lo := bearOB_lo[1]
    bullBrk_on := true

if bullOB_on[1] and not bullOB_on and low < bullOB_lo[1]
    bearBrk_hi := bullOB_hi[1]
    bearBrk_lo := bullOB_lo[1]
    bearBrk_on := true

inBullBrk = bullBrk_on and low <= bullBrk_hi and close >= bullBrk_lo
inBearBrk = bearBrk_on and high >= bearBrk_lo and close <= bearBrk_hi

if bullBrk_on and close < bullBrk_lo
    bullBrk_on := false
if bearBrk_on and close > bearBrk_hi
    bearBrk_on := false

// ============================================================================
// 11. HIGHER TIMEFRAME BIAS
// ============================================================================

htfClose = request.security(syminfo.tickerid, htfTF, close)
htfOpen  = request.security(syminfo.tickerid, htfTF, open)

htfBull = htfClose > htfOpen
htfBear = htfClose < htfOpen

htfATR      = request.security(syminfo.tickerid, htfTF, ta.atr(14))
htfBody     = math.abs(htfClose - htfOpen)
htfBullDisp = htfBull and htfBody > htfATR * 1.0
htfBearDisp = htfBear and htfBody > htfATR * 1.0

// ============================================================================
// 12. CONFLUENCE SCORING
// ============================================================================

var int bullC = 0
var int bearC = 0
bullC := 0
bearC := 0

if trend == 1
    bullC += 1
if trend == -1
    bearC += 1

if structureBull
    bullC += 1
if structureBear
    bearC += 1

if inBullOB or inBullBrk
    bullC += 1
if inBearOB or inBearBrk
    bearC += 1

if inBullFVG
    bullC += 1
if inBearFVG
    bearC += 1

if recentBullSweep
    bullC += 1
if recentBearSweep
    bearC += 1

if inOTE_bull
    bullC += 1
if inOTE_bear
    bearC += 1

if inDiscount and trend == 1
    bullC += 1
if inPremium and trend == -1
    bearC += 1

if htfBull or htfBullDisp
    bullC += 1
if htfBear or htfBearDisp
    bearC += 1

// ============================================================================
// 13. DAILY TRADE LIMITER
// ============================================================================

var int dayTrades = 0
if ta.change(time("D")) != 0
    dayTrades := 0
canGo = dayTrades < maxDaily

// ============================================================================
// 14. ENTRY CONDITIONS
// ============================================================================

goLong  = bullC >= minScore and kzOK and canGo and strategy.position_size <= 0
goShort = bearC >= minScore and kzOK and canGo and strategy.position_size >= 0

// ============================================================================
// 15. MAGNIFICENT STOP LOSS PLACEMENT
//     ICT's #1 rule: SL goes behind the liquidity that was already swept.
//     Smart money grabbed those stops — price has NO reason to return.
//     We use the deepest point: sweep candle wick > OB wick > swing low/high.
//     This is where the institutional order sits. Price bounces FROM here.
// ============================================================================

var float sl_long  = na
var float tp_long  = na
var float sl_short = na
var float tp_short = na
var float entryPx  = na
var int   entryBar = 0

if goLong
    // === MAGNIFICENT SL: Pick the deepest structural protection ===
    // Priority 1: Behind the sweep candle wick (liquidity already taken)
    // Priority 2: Behind the OB candle wick (institutional floor)
    // Priority 3: Behind the swing low (structural support)
    // Then add a tiny buffer so even a wick retest won't clip you

    sl1 = not na(sweepBullLow) ? sweepBullLow : na
    sl2 = bullOB_on ? bullOB_wick : na
    sl3 = not na(lastSL) ? lastSL : na

    // Use the DEEPEST (lowest) of all available levels = safest SL
    bestSL = close - atr * 3  // Fallback
    if not na(sl1)
        bestSL := sl1
    if not na(sl2) and sl2 < bestSL
        bestSL := sl2
    if not na(sl3) and sl3 < bestSL
        bestSL := sl3

    // Micro buffer: just 2 ticks below the level (enough to survive a retest wick)
    sl_long  := bestSL - syminfo.mintick * 2
    dist     = close - sl_long
    tp_long  := close + dist * rr
    entryPx  := close
    entryBar := bar_index

if goShort
    sl1 = not na(sweepBearHigh) ? sweepBearHigh : na
    sl2 = bearOB_on ? bearOB_wick : na
    sl3 = not na(lastSH) ? lastSH : na

    bestSL = close + atr * 3
    if not na(sl1)
        bestSL := sl1
    if not na(sl2) and sl2 > bestSL
        bestSL := sl2
    if not na(sl3) and sl3 > bestSL
        bestSL := sl3

    sl_short := bestSL + syminfo.mintick * 2
    dist     = sl_short - close
    tp_short := close - dist * rr
    entryPx  := close
    entryBar := bar_index

// ============================================================================
// 16. BREAK-EVEN — Lock profit, eliminate risk
// ============================================================================

if useBE and strategy.position_size > 0 and not na(entryPx) and not na(sl_long)
    oneR = entryPx + (entryPx - sl_long)
    if high >= oneR
        sl_long := entryPx + syminfo.mintick * 2

if useBE and strategy.position_size < 0 and not na(entryPx) and not na(sl_short)
    oneR = entryPx - (sl_short - entryPx)
    if low <= oneR
        sl_short := entryPx - syminfo.mintick * 2

// ============================================================================
// 17. TIME-BASED EXIT
// ============================================================================

timedExitLong  = strategy.position_size > 0 and (bar_index - entryBar) >= maxBarsInTrade
timedExitShort = strategy.position_size < 0 and (bar_index - entryBar) >= maxBarsInTrade

// ============================================================================
// 18. AUTONOMOUS EXECUTION
// ============================================================================

if goLong
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", stop=sl_long, limit=tp_long)
    dayTrades += 1

if goShort
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", stop=sl_short, limit=tp_short)
    dayTrades += 1

// Dynamic SL updates (break-even movement)
if strategy.position_size > 0 and not goLong
    strategy.exit("LX", "L", stop=sl_long, limit=tp_long)

if strategy.position_size < 0 and not goShort
    strategy.exit("SX", "S", stop=sl_short, limit=tp_short)

// Emergency: structure completely flips against you
if strategy.position_size > 0 and bearMSS
    strategy.close("L", comment="MSS Flip")

if strategy.position_size < 0 and bullMSS
    strategy.close("S", comment="MSS Flip")

// Time exit
if timedExitLong
    strategy.close("L", comment="Time")

if timedExitShort
    strategy.close("S", comment="Time")
