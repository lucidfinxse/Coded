// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// © ICT PD Array Engine - Every Concept, Multi-HTF, Pyramiding, Silent Execution
//@version=6
strategy("ICT PD Array Engine v6", overlay=true, margin_long=100, margin_short=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     pyramiding=3, calc_on_every_tick=true, process_orders_on_close=false,
     max_bars_back=500, fill_orders_on_standard_ohlc=true)

// ============================================================================
// INPUTS
// ============================================================================
grp_kz   = "Kill Zones & Silver Bullet"
ldnKZ    = input.session("0200-0500", "London KZ", group=grp_kz)
nyKZ     = input.session("0700-1000", "New York KZ", group=grp_kz)
ldnClKZ  = input.session("1000-1200", "London Close KZ", group=grp_kz)
asianSS  = input.session("2000-0000", "Asian Session", group=grp_kz)
sb1      = input.session("0300-0400", "Silver Bullet 1", group=grp_kz)
sb2      = input.session("1000-1100", "Silver Bullet 2", group=grp_kz)
sb3      = input.session("1400-1500", "Silver Bullet 3", group=grp_kz)

grp_ms   = "Market Structure"
swingLen = input.int(5, "Swing Length", minval=2, maxval=20, group=grp_ms)

grp_pd   = "PD Arrays"
obMaxAge  = input.int(80, "OB Max Age", minval=5, maxval=500, group=grp_pd)
fvgMaxAge = input.int(60, "FVG Max Age", minval=5, maxval=300, group=grp_pd)
eighthsLen = input.int(50, "Dealing Range Lookback", minval=10, maxval=200, group=grp_pd)

grp_ote  = "OTE"
oteFibHi = input.float(0.79, "OTE Upper", group=grp_ote)
oteFibLo = input.float(0.62, "OTE Lower", group=grp_ote)

grp_risk = "Risk & Pyramiding"
rr1      = input.float(1.0, "Partial TP1 R:R (50%)", group=grp_risk)
rr2      = input.float(1.5, "Partial TP2 R:R (30%)", group=grp_risk)
rr3      = input.float(2.0, "Final TP3 R:R (20%)", group=grp_risk)
useBE    = input.bool(true, "Break-Even at 1R", group=grp_risk)
maxDaily = input.int(500, "Max Daily Trades", group=grp_risk)
maxBars  = input.int(60, "Max Bars in Trade", group=grp_risk)

grp_htf  = "HTF Confluence"
htf1     = input.timeframe("5", "HTF 1 (5m)", group=grp_htf)
htf2     = input.timeframe("15", "HTF 2 (15m)", group=grp_htf)
htf3     = input.timeframe("60", "HTF 3 (1H)", group=grp_htf)
htf4     = input.timeframe("240", "HTF 4 (4H)", group=grp_htf)
htf5     = input.timeframe("D", "HTF 5 (Daily)", group=grp_htf)

grp_conf = "Confluence"
minScore = input.int(0, "Min Bonus Confluence (0-12)", minval=0, maxval=12, group=grp_conf, tooltip="4 mandatory gates met first (sweep+MSS+PD Array+KZ). Start at 0 to verify trades fire, then raise for quality.")

// ============================================================================
// ATR
// ============================================================================
atr = ta.atr(14)

// ============================================================================
// 1. KILL ZONES & SILVER BULLET
// ============================================================================
inLDN   = not na(time(timeframe.period, ldnKZ, "America/New_York"))
inNY    = not na(time(timeframe.period, nyKZ, "America/New_York"))
inLDNcl = not na(time(timeframe.period, ldnClKZ, "America/New_York"))
inAsian = not na(time(timeframe.period, asianSS, "America/New_York"))
inSB    = not na(time(timeframe.period, sb1, "America/New_York")) or not na(time(timeframe.period, sb2, "America/New_York")) or not na(time(timeframe.period, sb3, "America/New_York"))
inKZ    = inLDN or inNY or inLDNcl
kzOK    = inKZ or inSB

// ============================================================================
// 2. ASIAN RANGE + JUDAS SWING (AMD Power of 3)
// ============================================================================
var float asiaHi = na, var float asiaLo = na, var bool asiaOK = false

if inAsian
    if not inAsian[1]
        asiaHi := high
        asiaLo := low
        asiaOK := false
    else
        asiaHi := math.max(asiaHi, high)
        asiaLo := math.min(asiaLo, low)
if inAsian[1] and not inAsian
    asiaOK := true

asiaRaidHi = asiaOK and high > asiaHi and close < asiaHi
asiaRaidLo = asiaOK and low < asiaLo and close > asiaLo

// ============================================================================
// 3. PDH/PDL — Previous Day High/Low (Major Liquidity)
// ============================================================================
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pdhSweep = not na(pdh) and high > pdh and close < pdh
pdlSweep = not na(pdl) and low < pdl and close > pdl

// ============================================================================
// 4. PWH/PWL — Previous Week High/Low
// ============================================================================
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
pwhSweep = not na(pwh) and high > pwh and close < pwh
pwlSweep = not na(pwl) and low < pwl and close > pwl

// ============================================================================
// 5. MIDNIGHT OPEN — ICT's True Day Open
// ============================================================================
midnightOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

// ============================================================================
// 6. NDOG — New Day Opening Gap
// ============================================================================
prevDC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
currDO = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
ndogHi = math.max(nz(prevDC), nz(currDO))
ndogLo = math.min(nz(prevDC), nz(currDO))
ndogOn = math.abs(nz(prevDC) - nz(currDO)) > atr * 0.1
inNDOG = ndogOn and close >= ndogLo and close <= ndogHi

// ============================================================================
// 7. NWOG — New Week Opening Gap
// ============================================================================
prevWC = request.security(syminfo.tickerid, "W", close[1], lookahead=barmerge.lookahead_on)
currWO = request.security(syminfo.tickerid, "W", open, lookahead=barmerge.lookahead_on)
nwogHi = math.max(nz(prevWC), nz(currWO))
nwogLo = math.min(nz(prevWC), nz(currWO))
nwogOn = math.abs(nz(prevWC) - nz(currWO)) > atr * 0.2
inNWOG = nwogOn and close >= nwogLo and close <= nwogHi

// ============================================================================
// 8. MARKET STRUCTURE — BOS & MSS/CHoCH
// ============================================================================
swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na, var float lastSL = na
var float prevSH = na, var float prevSL = na
var int lastSHbar = 0, var int lastSLbar = 0
var int trend = 0

if not na(swH)
    prevSH := lastSH
    lastSH := swH
    lastSHbar := bar_index - swingLen
if not na(swL)
    prevSL := lastSL
    lastSL := swL
    lastSLbar := bar_index - swingLen

// Initialize trend from 0 on first structure break (fixes deadlock)
if trend == 0 and not na(lastSH) and close > lastSH
    trend := 1
if trend == 0 and not na(lastSL) and close < lastSL
    trend := -1

bullBOS = not na(lastSH) and close > lastSH and trend == 1
bearBOS = not na(lastSL) and close < lastSL and trend == -1
bullMSS = not na(lastSH) and close > lastSH and trend == -1
bearMSS = not na(lastSL) and close < lastSL and trend == 1

if bullBOS or bullMSS
    trend := 1
if bearBOS or bearMSS
    trend := -1

recentBullMSS = bullMSS or bullMSS[1] or bullMSS[2] or bullMSS[3] or bullMSS[4] or bullMSS[5] or bullMSS[6] or bullMSS[7] or bullMSS[8] or bullMSS[9] or bullMSS[10] or bullMSS[11] or bullMSS[12] or bullMSS[13] or bullMSS[14]
recentBearMSS = bearMSS or bearMSS[1] or bearMSS[2] or bearMSS[3] or bearMSS[4] or bearMSS[5] or bearMSS[6] or bearMSS[7] or bearMSS[8] or bearMSS[9] or bearMSS[10] or bearMSS[11] or bearMSS[12] or bearMSS[13] or bearMSS[14]

// ============================================================================
// 9. DISPLACEMENT — Institutional Intent
// ============================================================================
bodySize = math.abs(close - open)
bullDisp = close > open and bodySize > atr * 1.5
bearDisp = close < open and bodySize > atr * 1.5
recentBullDisp = bullDisp or bullDisp[1] or bullDisp[2] or bullDisp[3] or bullDisp[4] or bullDisp[5] or bullDisp[6] or bullDisp[7] or bullDisp[8] or bullDisp[9]
recentBearDisp = bearDisp or bearDisp[1] or bearDisp[2] or bearDisp[3] or bearDisp[4] or bearDisp[5] or bearDisp[6] or bearDisp[7] or bearDisp[8] or bearDisp[9]

// ============================================================================
// 10. ORDER BLOCKS + INVERSE ORDER BLOCKS (PD Array)
// ============================================================================
var float bullOB_hi = na, var float bullOB_lo = na
var int bullOB_bar = 0, var bool bullOB_on = false, var float bullOB_wick = na
var float bearOB_hi = na, var float bearOB_lo = na
var int bearOB_bar = 0, var bool bearOB_on = false, var float bearOB_wick = na
var float invBullOB_hi = na, var float invBullOB_lo = na, var bool invBullOB_on = false
var float invBearOB_hi = na, var float invBearOB_lo = na, var bool invBearOB_on = false

if bullDisp and close[1] < open[1]
    bullOB_hi := math.max(open[1], close[1])
    bullOB_lo := math.min(open[1], close[1])
    bullOB_wick := low[1]
    bullOB_bar := bar_index - 1
    bullOB_on := true

if bearDisp and close[1] > open[1]
    bearOB_hi := math.max(open[1], close[1])
    bearOB_lo := math.min(open[1], close[1])
    bearOB_wick := high[1]
    bearOB_bar := bar_index - 1
    bearOB_on := true

// OB mitigation → becomes Inverse OB (PD Array inversion)
if bullOB_on and close < bullOB_lo
    invBearOB_hi := bullOB_hi
    invBearOB_lo := bullOB_lo
    invBearOB_on := true
    bullOB_on := false
if bearOB_on and close > bearOB_hi
    invBullOB_hi := bearOB_hi
    invBullOB_lo := bearOB_lo
    invBullOB_on := true
    bearOB_on := false

if bullOB_on and (bar_index - bullOB_bar) > obMaxAge
    bullOB_on := false
if bearOB_on and (bar_index - bearOB_bar) > obMaxAge
    bearOB_on := false
if invBullOB_on and close < invBullOB_lo
    invBullOB_on := false
if invBearOB_on and close > invBearOB_hi
    invBearOB_on := false

inBullOB = bullOB_on and low <= bullOB_hi and close >= bullOB_lo
inBearOB = bearOB_on and high >= bearOB_lo and close <= bearOB_hi
inInvBullOB = invBullOB_on and low <= invBullOB_hi and close >= invBullOB_lo
inInvBearOB = invBearOB_on and high >= invBearOB_lo and close <= invBearOB_hi

// ============================================================================
// 11. FAIR VALUE GAPS + INVERSE FVG (PD Array)
// ============================================================================
var float bullFVG_hi = na, var float bullFVG_lo = na
var int bullFVG_bar = 0, var bool bullFVG_on = false
var float bearFVG_hi = na, var float bearFVG_lo = na
var int bearFVG_bar = 0, var bool bearFVG_on = false
var float invBullFVG_hi = na, var float invBullFVG_lo = na, var bool invBullFVG_on = false
var float invBearFVG_hi = na, var float invBearFVG_lo = na, var bool invBearFVG_on = false

if low > high[2] and (low - high[2]) > atr * 0.05
    bullFVG_hi := low
    bullFVG_lo := high[2]
    bullFVG_bar := bar_index - 1
    bullFVG_on := true
if high < low[2] and (low[2] - high) > atr * 0.05
    bearFVG_hi := low[2]
    bearFVG_lo := high
    bearFVG_bar := bar_index - 1
    bearFVG_on := true

// FVG mitigation → becomes Inverse FVG
if bullFVG_on and close < bullFVG_lo
    invBearFVG_hi := bullFVG_hi
    invBearFVG_lo := bullFVG_lo
    invBearFVG_on := true
    bullFVG_on := false
if bearFVG_on and close > bearFVG_hi
    invBullFVG_hi := bearFVG_hi
    invBullFVG_lo := bearFVG_lo
    invBullFVG_on := true
    bearFVG_on := false

if bullFVG_on and (bar_index - bullFVG_bar) > fvgMaxAge
    bullFVG_on := false
if bearFVG_on and (bar_index - bearFVG_bar) > fvgMaxAge
    bearFVG_on := false
if invBullFVG_on and close < invBullFVG_lo
    invBullFVG_on := false
if invBearFVG_on and close > invBearFVG_hi
    invBearFVG_on := false

inBullFVG = bullFVG_on and low <= bullFVG_hi and close >= bullFVG_lo
inBearFVG = bearFVG_on and high >= bearFVG_lo and close <= bearFVG_hi
inInvBullFVG = invBullFVG_on and low <= invBullFVG_hi and close >= invBullFVG_lo
inInvBearFVG = invBearFVG_on and high >= invBearFVG_lo and close <= invBearFVG_hi

// ============================================================================
// 12. BREAKER BLOCKS (PD Array)
// ============================================================================
var float bullBrk_hi = na, var float bullBrk_lo = na, var bool bullBrk_on = false
var float bearBrk_hi = na, var float bearBrk_lo = na, var bool bearBrk_on = false

if bearOB_on[1] and not bearOB_on and high > bearOB_hi[1]
    bullBrk_hi := bearOB_hi[1]
    bullBrk_lo := bearOB_lo[1]
    bullBrk_on := true
if bullOB_on[1] and not bullOB_on and low < bullOB_lo[1]
    bearBrk_hi := bullOB_hi[1]
    bearBrk_lo := bullOB_lo[1]
    bearBrk_on := true

inBullBrk = bullBrk_on and low <= bullBrk_hi and close >= bullBrk_lo
inBearBrk = bearBrk_on and high >= bearBrk_lo and close <= bearBrk_hi
if bullBrk_on and close < bullBrk_lo
    bullBrk_on := false
if bearBrk_on and close > bearBrk_hi
    bearBrk_on := false

// ============================================================================
// 13. MITIGATION BLOCKS (PD Array) — OB wicked into but body holds
// ============================================================================
var float bullMit_hi = na, var float bullMit_lo = na, var bool bullMit_on = false
var float bearMit_hi = na, var float bearMit_lo = na, var bool bearMit_on = false

bullMitCond = bullOB_on and low <= bullOB_hi and low >= bullOB_lo and close > bullOB_hi
if bullMitCond and not bullMit_on
    bullMit_hi := bullOB_hi
    bullMit_lo := bullOB_lo
    bullMit_on := true
bearMitCond = bearOB_on and high >= bearOB_lo and high <= bearOB_hi and close < bearOB_lo
if bearMitCond and not bearMit_on
    bearMit_hi := bearOB_hi
    bearMit_lo := bearOB_lo
    bearMit_on := true

inBullMit = bullMit_on and low <= bullMit_hi and close >= bullMit_lo
inBearMit = bearMit_on and high >= bearMit_lo and close <= bearMit_hi
if bullMit_on and close < bullMit_lo
    bullMit_on := false
if bearMit_on and close > bearMit_hi
    bearMit_on := false

// ============================================================================
// 14. REJECTION BLOCKS (PD Array) — Long wick candle that rejects from a level
// ============================================================================
wickUp   = high - math.max(open, close)
wickDown = math.min(open, close) - low
bullRejBlock = wickDown > bodySize * 2 and wickDown > atr * 0.5
bearRejBlock = wickUp > bodySize * 2 and wickUp > atr * 0.5

// ============================================================================
// 15. LIQUIDITY VOIDS (PD Array) — Large gap with no trading activity
// ============================================================================
liqVoidBull = low > high[1] and (low - high[1]) > atr * 0.8
liqVoidBear = high < low[1] and (low[1] - high) > atr * 0.8

// ============================================================================
// 16. LIQUIDITY SWEEPS (Equal H/L + Swing + PDH/PDL + PWH/PWL + Asia)
// ============================================================================
var float eqHiLvl = na, var float eqLoLvl = na
var bool eqHiOn = false, var bool eqLoOn = false
var float sweepBullLow = na, var float sweepBearHigh = na

if not na(swH) and not na(prevSH)
    tol = prevSH * 0.0005
    if math.abs(swH - prevSH) < tol
        eqHiLvl := math.max(swH, prevSH)
        eqHiOn := true
if not na(swL) and not na(prevSL)
    tol = prevSL * 0.0005
    if math.abs(swL - prevSL) < tol
        eqLoLvl := math.min(swL, prevSL)
        eqLoOn := true

eqLoSweep = eqLoOn and low < eqLoLvl and close > eqLoLvl
eqHiSweep = eqHiOn and high > eqHiLvl and close < eqHiLvl
swSweepBull = not na(lastSL) and low < lastSL and close > lastSL
swSweepBear = not na(lastSH) and high > lastSH and close < lastSH

liqBull = eqLoSweep or swSweepBull or pdlSweep or pwlSweep or asiaRaidLo
liqBear = eqHiSweep or swSweepBear or pdhSweep or pwhSweep or asiaRaidHi

if liqBull
    sweepBullLow := low
if liqBear
    sweepBearHigh := high

recentBullSweep = liqBull or liqBull[1] or liqBull[2] or liqBull[3] or liqBull[4] or liqBull[5] or liqBull[6] or liqBull[7] or liqBull[8] or liqBull[9] or liqBull[10] or liqBull[11] or liqBull[12] or liqBull[13] or liqBull[14]
recentBearSweep = liqBear or liqBear[1] or liqBear[2] or liqBear[3] or liqBear[4] or liqBear[5] or liqBear[6] or liqBear[7] or liqBear[8] or liqBear[9] or liqBear[10] or liqBear[11] or liqBear[12] or liqBear[13] or liqBear[14]
if eqLoSweep
    eqLoOn := false
if eqHiSweep
    eqHiOn := false

// ============================================================================
// 17. TURTLE SOUP (PD Array) — Grab beyond prev session H/L then reverse
// ============================================================================
var float prevSessHi = na, var float prevSessLo = na
// ta.highest/ta.lowest must be called on every bar (Pine Script requirement)
_highest60 = ta.highest(high, 60)
_lowest60  = ta.lowest(low, 60)
if inKZ and not inKZ[1]
    prevSessHi := _highest60
    prevSessLo := _lowest60

turtleBull = not na(prevSessLo) and inKZ and low < prevSessLo and close > prevSessLo
turtleBear = not na(prevSessHi) and inKZ and high > prevSessHi and close < prevSessHi

if turtleBull and not na(sweepBullLow)
    sweepBullLow := math.min(sweepBullLow, low)
if turtleBear and not na(sweepBearHigh)
    sweepBearHigh := math.max(sweepBearHigh, high)

// ============================================================================
// 18. OTE — Optimal Trade Entry (Fib 62-79%)
// ============================================================================
var bool inOTE_bull = false, var bool inOTE_bear = false

if not na(lastSH) and not na(lastSL) and lastSH > lastSL
    if trend == 1
        f62 = lastSH - (lastSH - lastSL) * oteFibLo
        f79 = lastSH - (lastSH - lastSL) * oteFibHi
        inOTE_bull := close <= f62 and close >= f79
        inOTE_bear := false
    else
        f62 = lastSL + (lastSH - lastSL) * oteFibLo
        f79 = lastSL + (lastSH - lastSL) * oteFibHi
        inOTE_bear := close >= f62 and close <= f79
        inOTE_bull := false
else
    inOTE_bull := false
    inOTE_bear := false

// ============================================================================
// 19. PREMIUM / DISCOUNT with QUADRANTS (4 zones)
// ============================================================================
drHi = ta.highest(high, eighthsLen)
drLo = ta.lowest(low, eighthsLen)
drRange = drHi - drLo
eq   = drLo + drRange * 0.5

q1 = drLo + drRange * 0.25   // Deep discount
q2 = drLo + drRange * 0.50   // Equilibrium
q3 = drLo + drRange * 0.75   // Premium

inDiscount     = close < q2
inPremium      = close > q2
inDeepDiscount = close < q1
inDeepPremium  = close > q3

eighthBull = inDiscount           // Below EQ = buy zone
eighthBear = inPremium            // Above EQ = sell zone
eighthSweetBull = inDeepDiscount  // Deep discount
eighthSweetBear = inDeepPremium   // Deep premium

// ============================================================================
// 20. MULTI-TIMEFRAME BIAS + HTF PD ARRAYS
//     ICT's key teaching: the BEST trades happen when HTF PD Arrays
//     and LTF PD Arrays LINE UP at the same price level.
//     A 15m OB inside a 1H FVG with a 1m OB entry = highest probability.
// ============================================================================

// --- HTF Candle Bias (direction) ---
htf1c = request.security(syminfo.tickerid, htf1, close)
htf1o = request.security(syminfo.tickerid, htf1, open)
htf1bull = htf1c > htf1o
htf1bear = htf1c < htf1o

htf2c = request.security(syminfo.tickerid, htf2, close)
htf2o = request.security(syminfo.tickerid, htf2, open)
htf2bull = htf2c > htf2o
htf2bear = htf2c < htf2o

htf3c = request.security(syminfo.tickerid, htf3, close)
htf3o = request.security(syminfo.tickerid, htf3, open)
htf3bull = htf3c > htf3o
htf3bear = htf3c < htf3o

htf4c = request.security(syminfo.tickerid, htf4, close)
htf4o = request.security(syminfo.tickerid, htf4, open)
htf4bull = htf4c > htf4o
htf4bear = htf4c < htf4o

htf5c = request.security(syminfo.tickerid, htf5, close)
htf5o = request.security(syminfo.tickerid, htf5, open)
htf5bull = htf5c > htf5o
htf5bear = htf5c < htf5o

htfBullCount = (htf1bull ? 1 : 0) + (htf2bull ? 1 : 0) + (htf3bull ? 1 : 0) + (htf4bull ? 1 : 0) + (htf5bull ? 1 : 0)
htfBearCount = (htf1bear ? 1 : 0) + (htf2bear ? 1 : 0) + (htf3bear ? 1 : 0) + (htf4bear ? 1 : 0) + (htf5bear ? 1 : 0)
htfStrongBull = htfBullCount >= 2
htfStrongBear = htfBearCount >= 2

// --- 15m PD Arrays (Order Blocks + FVGs from 15m chart) ---
htf2_h  = request.security(syminfo.tickerid, htf2, high)
htf2_l  = request.security(syminfo.tickerid, htf2, low)
htf2_h1 = request.security(syminfo.tickerid, htf2, high[1])
htf2_l1 = request.security(syminfo.tickerid, htf2, low[1])
htf2_o1 = request.security(syminfo.tickerid, htf2, open[1])
htf2_c1 = request.security(syminfo.tickerid, htf2, close[1])
htf2_h2 = request.security(syminfo.tickerid, htf2, high[2])
htf2_atr = request.security(syminfo.tickerid, htf2, ta.atr(14))

// 15m Bullish OB: prior 15m candle bearish before bullish displacement on 15m
htf2_bullDisp = htf2c > htf2o and math.abs(htf2c - htf2o) > htf2_atr * 1.2
htf2_bearDisp = htf2c < htf2o and math.abs(htf2c - htf2o) > htf2_atr * 1.2

var float htf2_bullOB_hi = na, var float htf2_bullOB_lo = na, var bool htf2_bullOB_on = false
var float htf2_bearOB_hi = na, var float htf2_bearOB_lo = na, var bool htf2_bearOB_on = false

if htf2_bullDisp and htf2_c1 < htf2_o1
    htf2_bullOB_hi := math.max(htf2_o1, htf2_c1)
    htf2_bullOB_lo := math.min(htf2_o1, htf2_c1)
    htf2_bullOB_on := true
if htf2_bearDisp and htf2_c1 > htf2_o1
    htf2_bearOB_hi := math.max(htf2_o1, htf2_c1)
    htf2_bearOB_lo := math.min(htf2_o1, htf2_c1)
    htf2_bearOB_on := true
if htf2_bullOB_on and close < htf2_bullOB_lo
    htf2_bullOB_on := false
if htf2_bearOB_on and close > htf2_bearOB_hi
    htf2_bearOB_on := false

// 15m FVG
htf2_bullFVG_cond = htf2_l > htf2_h2
var float htf2_bullFVG_hi = na, var float htf2_bullFVG_lo = na, var bool htf2_bullFVG_on = false
var float htf2_bearFVG_hi = na, var float htf2_bearFVG_lo = na, var bool htf2_bearFVG_on = false
htf2_bearFVG_cond = htf2_h < request.security(syminfo.tickerid, htf2, low[2])

if htf2_bullFVG_cond
    htf2_bullFVG_hi := htf2_l
    htf2_bullFVG_lo := htf2_h2
    htf2_bullFVG_on := true
if htf2_bearFVG_cond
    htf2_bearFVG_hi := request.security(syminfo.tickerid, htf2, low[2])
    htf2_bearFVG_lo := htf2_h
    htf2_bearFVG_on := true
if htf2_bullFVG_on and close < htf2_bullFVG_lo
    htf2_bullFVG_on := false
if htf2_bearFVG_on and close > htf2_bearFVG_hi
    htf2_bearFVG_on := false

// 1m price inside 15m PD Arrays?
in15mBullPDA = (htf2_bullOB_on and close >= htf2_bullOB_lo and close <= htf2_bullOB_hi) or (htf2_bullFVG_on and close >= htf2_bullFVG_lo and close <= htf2_bullFVG_hi)
in15mBearPDA = (htf2_bearOB_on and close >= htf2_bearOB_lo and close <= htf2_bearOB_hi) or (htf2_bearFVG_on and close >= htf2_bearFVG_lo and close <= htf2_bearFVG_hi)

// --- 1H PD Arrays (Order Blocks + FVGs from 1H chart) ---
htf3_h  = request.security(syminfo.tickerid, htf3, high)
htf3_l  = request.security(syminfo.tickerid, htf3, low)
htf3_h1 = request.security(syminfo.tickerid, htf3, high[1])
htf3_l1 = request.security(syminfo.tickerid, htf3, low[1])
htf3_o1 = request.security(syminfo.tickerid, htf3, open[1])
htf3_c1 = request.security(syminfo.tickerid, htf3, close[1])
htf3_h2 = request.security(syminfo.tickerid, htf3, high[2])
htf3_atr = request.security(syminfo.tickerid, htf3, ta.atr(14))

htf3_bullDisp = htf3c > htf3o and math.abs(htf3c - htf3o) > htf3_atr * 1.2
htf3_bearDisp = htf3c < htf3o and math.abs(htf3c - htf3o) > htf3_atr * 1.2

var float htf3_bullOB_hi = na, var float htf3_bullOB_lo = na, var bool htf3_bullOB_on = false
var float htf3_bearOB_hi = na, var float htf3_bearOB_lo = na, var bool htf3_bearOB_on = false

if htf3_bullDisp and htf3_c1 < htf3_o1
    htf3_bullOB_hi := math.max(htf3_o1, htf3_c1)
    htf3_bullOB_lo := math.min(htf3_o1, htf3_c1)
    htf3_bullOB_on := true
if htf3_bearDisp and htf3_c1 > htf3_o1
    htf3_bearOB_hi := math.max(htf3_o1, htf3_c1)
    htf3_bearOB_lo := math.min(htf3_o1, htf3_c1)
    htf3_bearOB_on := true
if htf3_bullOB_on and close < htf3_bullOB_lo
    htf3_bullOB_on := false
if htf3_bearOB_on and close > htf3_bearOB_hi
    htf3_bearOB_on := false

// 1H FVG
htf3_bullFVG_cond = htf3_l > htf3_h2
var float htf3_bullFVG_hi = na, var float htf3_bullFVG_lo = na, var bool htf3_bullFVG_on = false
var float htf3_bearFVG_hi = na, var float htf3_bearFVG_lo = na, var bool htf3_bearFVG_on = false
htf3_bearFVG_cond = htf3_h < request.security(syminfo.tickerid, htf3, low[2])

if htf3_bullFVG_cond
    htf3_bullFVG_hi := htf3_l
    htf3_bullFVG_lo := htf3_h2
    htf3_bullFVG_on := true
if htf3_bearFVG_cond
    htf3_bearFVG_hi := request.security(syminfo.tickerid, htf3, low[2])
    htf3_bearFVG_lo := htf3_h
    htf3_bearFVG_on := true
if htf3_bullFVG_on and close < htf3_bullFVG_lo
    htf3_bullFVG_on := false
if htf3_bearFVG_on and close > htf3_bearFVG_hi
    htf3_bearFVG_on := false

// 1m price inside 1H PD Arrays?
in1hBullPDA = (htf3_bullOB_on and close >= htf3_bullOB_lo and close <= htf3_bullOB_hi) or (htf3_bullFVG_on and close >= htf3_bullFVG_lo and close <= htf3_bullFVG_hi)
in1hBearPDA = (htf3_bearOB_on and close >= htf3_bearOB_lo and close <= htf3_bearOB_hi) or (htf3_bearFVG_on and close >= htf3_bearFVG_lo and close <= htf3_bearFVG_hi)

// ============================================================================
// 21. CONFIRMATION CANDLE — Rejection or Engulfing at entry zone
// ============================================================================
bullWickR = high != low ? (close - low) / (high - low) : 0.0
bearWickR = high != low ? (high - close) / (high - low) : 0.0
bullReject = bullWickR > 0.65 and bodySize < (high - low) * 0.4
bearReject = bearWickR > 0.65 and bodySize < (high - low) * 0.4
bullEngulf = close > open and close > high[1] and open <= low[1]
bearEngulf = close < open and close < low[1] and open >= high[1]
confirmBull = bullReject or bullEngulf or bullRejBlock
confirmBear = bearReject or bearEngulf or bearRejBlock

// ============================================================================
// 22. LTF PD Array + HTF PD Array STACKING
//     ICT's highest probability: when PD Arrays from multiple timeframes
//     line up at the same price — that's where institutions have orders stacked.
//     A 1m OB sitting inside a 15m FVG inside a 1H OB = "the trade of the day"
// ============================================================================

// LTF PD Array delivery (1m price in a 1m PD Array zone)
pdArrayBull = inBullOB or inBullFVG or inBullBrk or inInvBullOB or inBullMit or inInvBullFVG
pdArrayBear = inBearOB or inBearFVG or inBearBrk or inInvBearOB or inBearMit or inInvBearFVG

// HTF PD Array STACKING — LTF PD Array overlaps with HTF PD Array
htfPDAstackBull = pdArrayBull and (in15mBullPDA or in1hBullPDA)
htfPDAstackBear = pdArrayBear and (in15mBearPDA or in1hBearPDA)

// Any HTF PD Array present (even without LTF overlap)
anyHTFbullPDA = in15mBullPDA or in1hBullPDA
anyHTFbearPDA = in15mBearPDA or in1hBearPDA

// Recent confirmation candle (within last 3 bars)
recentConfirmBull = confirmBull or confirmBull[1] or confirmBull[2]
recentConfirmBear = confirmBear or confirmBear[1] or confirmBear[2]

// ============================================================================
// 23. MANDATORY CONDITIONS
//     4 core conditions — all must be true to enter
//     PD Array check includes HTF PD Arrays (15m/1H OB or FVG counts)
// ============================================================================
// PD Array gate: in ANY PD Array (1m OR 15m OR 1H) — HTF PD Arrays count
anyPDAbull = pdArrayBull or in15mBullPDA or in1hBullPDA
anyPDAbear = pdArrayBear or in15mBearPDA or in1hBearPDA

mandatoryBull = recentBullSweep and recentBullMSS and anyPDAbull and kzOK
mandatoryBear = recentBearSweep and recentBearMSS and anyPDAbear and kzOK

// ============================================================================
// 23. BONUS CONFLUENCE SCORE (extra weight on top of mandatory)
//     These add confidence but aren't required
// ============================================================================
var int bullC = 0, var int bearC = 0
bullC := 0
bearC := 0

// +3 HTF PD Array STACKING (THE highest probability — ICT's best concept)
//    When 1m PD Array sits inside 15m or 1H PD Array = institutional order stacking
if htfPDAstackBull
    bullC += 3
else if anyHTFbullPDA
    bullC += 1  // HTF PD Array present but not overlapping with LTF
if htfPDAstackBear
    bearC += 3
else if anyHTFbearPDA
    bearC += 1

// +2 Confirmation candle (reaction from PD Array — very important)
if recentConfirmBull
    bullC += 2
if recentConfirmBear
    bearC += 2

// +2 HTF bias alignment (top-down direction)
if htfStrongBull
    bullC += 2
if htfStrongBear
    bearC += 2

// +1 Displacement present (institutional intent)
if recentBullDisp
    bullC += 1
if recentBearDisp
    bearC += 1

// +1 OTE zone (sniper precision)
if inOTE_bull
    bullC += 1
if inOTE_bear
    bearC += 1

// +2 Correct 8th/quadrant alignment (moved from mandatory to scored)
if eighthSweetBull
    bullC += 2
else if eighthBull
    bullC += 1
if eighthSweetBear
    bearC += 2
else if eighthBear
    bearC += 1

// +1 NDOG/NWOG alignment
if inNDOG or inNWOG
    bullC += 1
    bearC += 1

// +1 Silver Bullet window
if inSB
    bullC += 1
    bearC += 1

// +1 Turtle Soup
if turtleBull
    bullC += 1
if turtleBear
    bearC += 1

// +1 Rejection Block
if bullRejBlock and inDiscount
    bullC += 1
if bearRejBlock and inPremium
    bearC += 1

// +1 4+ HTFs aligned (very strong)
if htfBullCount >= 4
    bullC += 1
if htfBearCount >= 4
    bearC += 1

// ============================================================================
// 24. DAILY TRADE LIMITER
// ============================================================================
var int dayTrades = 0
if ta.change(time("D")) != 0
    dayTrades := 0
canGo = dayTrades < maxDaily

// ============================================================================
// 25. ENTRY CONDITIONS — ICT 2022 Model + Pyramid Logic
//     ALL mandatory conditions must be met. Bonus score adds confidence.
//     Entry 1: Full model (all mandatory + bonus >= 1)
//     Entry 2: Pyramid at deeper PD Array retest while in profit
//     Entry 3: Pyramid at OTE zone with confirmation
// ============================================================================
noPos    = strategy.position_size == 0
isLong   = strategy.position_size > 0
isShort  = strategy.position_size < 0

// First entry — Mandatory gates met, bonus adds quality
// If no trades appear, set Min Bonus to 0 in settings to test mandatory gates alone
goLong1  = mandatoryBull and canGo and noPos and bullC >= minScore
goShort1 = mandatoryBear and canGo and noPos and bearC >= minScore

// Pyramid entry 2 — deeper PD Array retest while in profit + mandatory gates still hold
goLong2  = isLong and strategy.openprofit > 0 and pdArrayBull and recentConfirmBull and htfStrongBull and eighthBull and strategy.opentrades < 2
goShort2 = isShort and strategy.openprofit > 0 and pdArrayBear and recentConfirmBear and htfStrongBear and eighthBear and strategy.opentrades < 2

// Pyramid entry 3 — OTE zone with confirmation while profitable
goLong3  = isLong and strategy.openprofit > 0 and inOTE_bull and confirmBull and htfStrongBull and strategy.opentrades < 3
goShort3 = isShort and strategy.openprofit > 0 and inOTE_bear and confirmBear and htfStrongBear and strategy.opentrades < 3

// ============================================================================
// 25. MAGNIFICENT STOP LOSS (ICT's SL Concepts)
//     Priority 1: Behind sweep candle wick (liquidity already grabbed)
//     Priority 2: Behind OB candle wick (institutional floor/ceiling)
//     Priority 3: Behind swing low/high (structural protection)
//     Pick the DEEPEST + 2 tick micro-buffer
// ============================================================================
var float sl_l = na, var float tp1_l = na, var float tp2_l = na, var float tp3_l = na
var float sl_s = na, var float tp1_s = na, var float tp2_s = na, var float tp3_s = na
var float entryPx = na, var int entryBar = 0

if goLong1
    s1 = not na(sweepBullLow) ? sweepBullLow : na
    s2 = bullOB_on ? bullOB_wick : na
    s3 = not na(lastSL) ? lastSL : na
    best = close - atr * 3
    if not na(s1)
        best := s1
    if not na(s2) and s2 < best
        best := s2
    if not na(s3) and s3 < best
        best := s3
    sl_l := best - syminfo.mintick * 2
    dist = close - sl_l
    // ICT Partial TPs — take profit where price delivers to opposing PD Arrays
    tp1_l := close + dist * rr1   // 50% off at 1R (secure the bag)
    tp2_l := close + dist * rr2   // 30% off at 1.5R
    // Final TP: opposing liquidity (PDH/equilibrium) or 2R — whichever is closer
    oppLiq = not na(pdh) and pdh > close ? pdh : close + dist * rr3
    tp3_l := oppLiq  // 20% rides to opposing liquidity
    entryPx := close
    entryBar := bar_index

if goShort1
    s1 = not na(sweepBearHigh) ? sweepBearHigh : na
    s2 = bearOB_on ? bearOB_wick : na
    s3 = not na(lastSH) ? lastSH : na
    best = close + atr * 3
    if not na(s1)
        best := s1
    if not na(s2) and s2 > best
        best := s2
    if not na(s3) and s3 > best
        best := s3
    sl_s := best + syminfo.mintick * 2
    dist = sl_s - close
    tp1_s := close - dist * rr1   // 50% off at 1R
    tp2_s := close - dist * rr2   // 30% off at 1.5R
    oppLiq = not na(pdl) and pdl < close ? pdl : close - dist * rr3
    tp3_s := oppLiq  // 20% rides to opposing liquidity
    entryPx := close
    entryBar := bar_index

// ============================================================================
// 26. BREAK-EVEN AT 1R — Eliminate risk once in profit
// ============================================================================
if useBE and isLong and not na(entryPx) and not na(sl_l)
    oneR = entryPx + (entryPx - sl_l)
    if high >= oneR
        sl_l := entryPx + syminfo.mintick * 2

if useBE and isShort and not na(entryPx) and not na(sl_s)
    oneR = entryPx - (sl_s - entryPx)
    if low <= oneR
        sl_s := entryPx - syminfo.mintick * 2

// ============================================================================
// 27. TIME EXIT — Don't hold 1m trades too long
// ============================================================================
timeExitL = isLong and (bar_index - entryBar) >= maxBars
timeExitS = isShort and (bar_index - entryBar) >= maxBars

// ============================================================================
// 28. AUTONOMOUS EXECUTION — Pyramiding + Partial TPs
//     ICT's partial profit: 25% at TP1, 25% at TP2, 50% rides to TP3
// ============================================================================

// Entry 1 — Initial position
if goLong1
    strategy.entry("L1", strategy.long)
    strategy.exit("LX1", "L1", stop=sl_l, limit=tp1_l, qty_percent=50)
    strategy.exit("LX2", "L1", stop=sl_l, limit=tp2_l, qty_percent=60)
    strategy.exit("LX3", "L1", stop=sl_l, limit=tp3_l)
    dayTrades += 1

if goShort1
    strategy.entry("S1", strategy.short)
    strategy.exit("SX1", "S1", stop=sl_s, limit=tp1_s, qty_percent=50)
    strategy.exit("SX2", "S1", stop=sl_s, limit=tp2_s, qty_percent=60)
    strategy.exit("SX3", "S1", stop=sl_s, limit=tp3_s)
    dayTrades += 1

// Entry 2 — Pyramid add at PD Array retest
if goLong2
    strategy.entry("L2", strategy.long)
    strategy.exit("L2X", "L2", stop=sl_l, limit=tp3_l)
    dayTrades += 1

if goShort2
    strategy.entry("S2", strategy.short)
    strategy.exit("S2X", "S2", stop=sl_s, limit=tp3_s)
    dayTrades += 1

// Entry 3 — Pyramid add at OTE
if goLong3
    strategy.entry("L3", strategy.long)
    strategy.exit("L3X", "L3", stop=sl_l, limit=tp3_l)
    dayTrades += 1

if goShort3
    strategy.entry("S3", strategy.short)
    strategy.exit("S3X", "S3", stop=sl_s, limit=tp3_s)
    dayTrades += 1

// Dynamic SL updates (break-even movement)
if isLong and not goLong1
    strategy.exit("LX1", "L1", stop=sl_l, limit=tp1_l, qty_percent=50)
    strategy.exit("LX2", "L1", stop=sl_l, limit=tp2_l, qty_percent=60)
    strategy.exit("LX3", "L1", stop=sl_l, limit=tp3_l)
    strategy.exit("L2X", "L2", stop=sl_l, limit=tp3_l)
    strategy.exit("L3X", "L3", stop=sl_l, limit=tp3_l)

if isShort and not goShort1
    strategy.exit("SX1", "S1", stop=sl_s, limit=tp1_s, qty_percent=50)
    strategy.exit("SX2", "S1", stop=sl_s, limit=tp2_s, qty_percent=60)
    strategy.exit("SX3", "S1", stop=sl_s, limit=tp3_s)
    strategy.exit("S2X", "S2", stop=sl_s, limit=tp3_s)
    strategy.exit("S3X", "S3", stop=sl_s, limit=tp3_s)

// Emergency MSS exit — structure completely flips
if isLong and bearMSS
    strategy.close_all(comment="MSS Flip")
if isShort and bullMSS
    strategy.close_all(comment="MSS Flip")

// Time exit
if timeExitL
    strategy.close_all(comment="Time")
if timeExitS
    strategy.close_all(comment="Time")
