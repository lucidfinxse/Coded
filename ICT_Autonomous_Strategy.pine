// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// © ICT Pure Concepts - Autonomous Execution Engine
//@version=6
strategy("ICT Sniper v6", overlay=true, margin_long=100, margin_short=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=2,
     pyramiding=0, calc_on_every_tick=true, process_orders_on_close=false,
     max_bars_back=500, fill_orders_on_standard_ohlc=true)

// ============================================================================
// INPUTS
// ============================================================================

grp_kz  = "Kill Zones"
useKZ   = input.bool(true, "Only Trade Kill Zones", group=grp_kz)
ldnKZ   = input.session("0200-0500", "London KZ", group=grp_kz)
nyKZ    = input.session("0700-1000", "New York KZ", group=grp_kz)
ldnClKZ = input.session("1000-1200", "London Close KZ", group=grp_kz)
asianSS = input.session("2000-0000", "Asian Session", group=grp_kz)

grp_ms  = "Market Structure"
swingLen = input.int(3, "Swing Length (1m optimized)", minval=1, maxval=20, group=grp_ms)

grp_ob  = "Order Blocks"
obMaxAge = input.int(60, "OB Max Age (bars)", minval=5, maxval=300, group=grp_ob)

grp_fvg = "Fair Value Gaps"
fvgMaxAge = input.int(40, "FVG Max Age (bars)", minval=5, maxval=200, group=grp_fvg)

grp_ote = "Optimal Trade Entry"
oteFibHi = input.float(0.79, "OTE Upper Fib", minval=0.5, maxval=0.95, step=0.01, group=grp_ote)
oteFibLo = input.float(0.62, "OTE Lower Fib", minval=0.5, maxval=0.95, step=0.01, group=grp_ote)

grp_risk = "Risk Management"
rr       = input.float(2.0, "Risk:Reward", minval=1.0, maxval=10.0, step=0.5, group=grp_risk)
slBuff   = input.float(0.3, "SL Buffer (ATR x)", minval=0.0, maxval=2.0, step=0.1, group=grp_risk)
useBE    = input.bool(true, "Move SL to Break-Even at 1R", group=grp_risk)
maxDaily = input.int(500, "Max Daily Trades", minval=1, maxval=1000, group=grp_risk)
maxBarsInTrade = input.int(30, "Max Bars in Trade (time exit)", minval=5, maxval=200, group=grp_risk)

grp_htf  = "HTF Bias"
htfTF    = input.timeframe("15", "HTF Timeframe", group=grp_htf)

grp_conf = "Confluence"
minScore = input.int(5, "Min Confluence (1-8)", minval=1, maxval=8, group=grp_conf, tooltip="Higher = fewer but better trades. 5-6 recommended for high win rate.")

// ============================================================================
// ATR
// ============================================================================

atr = ta.atr(14)

// ============================================================================
// 1. KILL ZONES — Only trade when smart money is active
// ============================================================================

inLDN    = not na(time(timeframe.period, ldnKZ, "America/New_York"))
inNY     = not na(time(timeframe.period, nyKZ, "America/New_York"))
inLDNcl  = not na(time(timeframe.period, ldnClKZ, "America/New_York"))
inAsian  = not na(time(timeframe.period, asianSS, "America/New_York"))
inKZ     = inLDN or inNY or inLDNcl
kzOK     = useKZ ? inKZ : true

// ============================================================================
// 2. ASIAN RANGE — Defines the manipulation/liquidity pool
//    ICT teaches the Asian range gets raided before the real move
// ============================================================================

var float asiaHi = na
var float asiaLo = na
var bool  asiaLocked = false

if inAsian
    if not inAsian[1]
        asiaHi := high
        asiaLo := low
        asiaLocked := false
    else
        asiaHi := math.max(asiaHi, high)
        asiaLo := math.min(asiaLo, low)

if inAsian[1] and not inAsian
    asiaLocked := true

// Asian range raid (Judas Swing / manipulation)
asiaRaidHigh = asiaLocked and high > asiaHi and close < asiaHi  // Swept asia high, closed back below = bearish raid
asiaRaidLow  = asiaLocked and low < asiaLo and close > asiaLo   // Swept asia low, closed back above = bullish raid

// ============================================================================
// 3. MARKET STRUCTURE — BOS & CHoCH (MSS)
//    ICT's Market Structure Shift is the #1 confirmation
// ============================================================================

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSH    = na
var float lastSL    = na
var float prevSH    = na
var float prevSL    = na
var int   lastSHbar = 0
var int   lastSLbar = 0
var int   trend     = 0  // 1=bull, -1=bear

if not na(swH)
    prevSH    := lastSH
    lastSH    := swH
    lastSHbar := bar_index - swingLen

if not na(swL)
    prevSL    := lastSL
    lastSL    := swL
    lastSLbar := bar_index - swingLen

// Break of Structure (continuation)
bullBOS = not na(lastSH) and close > lastSH and trend == 1
bearBOS = not na(lastSL) and close < lastSL and trend == -1

// Change of Character / Market Structure Shift (reversal) — THE key signal
bullMSS = not na(lastSH) and close > lastSH and trend == -1
bearMSS = not na(lastSL) and close < lastSL and trend == 1

if bullBOS or bullMSS
    trend := 1
if bearBOS or bearMSS
    trend := -1

// Recent MSS (within last few bars — entry window)
recentBullMSS = bullMSS or bullMSS[1] or bullMSS[2] or bullMSS[3]
recentBearMSS = bearMSS or bearMSS[1] or bearMSS[2] or bearMSS[3]

// ============================================================================
// 4. DISPLACEMENT — Institutional candle showing intent
//    ICT says displacement MUST be present to confirm smart money
// ============================================================================

bodySize    = math.abs(close - open)
bullDisp    = close > open and bodySize > atr * 1.5
bearDisp    = close < open and bodySize > atr * 1.5
recentBullDisp = bullDisp or bullDisp[1] or bullDisp[2] or bullDisp[3]
recentBearDisp = bearDisp or bearDisp[1] or bearDisp[2] or bearDisp[3]

// ============================================================================
// 5. ORDER BLOCKS — Last opposing candle before displacement
//    ICT's institutional footprint
// ============================================================================

var float bullOB_hi  = na
var float bullOB_lo  = na
var int   bullOB_bar = 0
var bool  bullOB_on  = false

var float bearOB_hi  = na
var float bearOB_lo  = na
var int   bearOB_bar = 0
var bool  bearOB_on  = false

// Bullish OB: bearish candle right before bullish displacement
if bullDisp and close[1] < open[1]
    bullOB_hi  := math.max(open[1], close[1])
    bullOB_lo  := math.min(open[1], close[1])
    bullOB_bar := bar_index - 1
    bullOB_on  := true

// Bearish OB: bullish candle right before bearish displacement
if bearDisp and close[1] > open[1]
    bearOB_hi  := math.max(open[1], close[1])
    bearOB_lo  := math.min(open[1], close[1])
    bearOB_bar := bar_index - 1
    bearOB_on  := true

// Mitigation (OB touched through = dead)
if bullOB_on and close < bullOB_lo
    bullOB_on := false
if bearOB_on and close > bearOB_hi
    bearOB_on := false

// Age expiry
if bullOB_on and (bar_index - bullOB_bar) > obMaxAge
    bullOB_on := false
if bearOB_on and (bar_index - bearOB_bar) > obMaxAge
    bearOB_on := false

// Price tapping into OB
inBullOB = bullOB_on and low <= bullOB_hi and close >= bullOB_lo
inBearOB = bearOB_on and high >= bearOB_lo and close <= bearOB_hi

// ============================================================================
// 6. FAIR VALUE GAPS — Imbalance left by displacement
//    ICT teaches price MUST return to fill these
// ============================================================================

var float bullFVG_hi = na
var float bullFVG_lo = na
var int   bullFVG_bar = 0
var bool  bullFVG_on = false

var float bearFVG_hi = na
var float bearFVG_lo = na
var int   bearFVG_bar = 0
var bool  bearFVG_on = false

// Bullish FVG: gap up (candle 1 high < candle 3 low)
if low > high[2] and (low - high[2]) > atr * 0.003
    bullFVG_hi  := low
    bullFVG_lo  := high[2]
    bullFVG_bar := bar_index - 1
    bullFVG_on  := true

// Bearish FVG: gap down
if high < low[2] and (low[2] - high) > atr * 0.003
    bearFVG_hi  := low[2]
    bearFVG_lo  := high
    bearFVG_bar := bar_index - 1
    bearFVG_on  := true

// Mitigation
if bullFVG_on and close < bullFVG_lo
    bullFVG_on := false
if bearFVG_on and close > bearFVG_hi
    bearFVG_on := false

// Age expiry
if bullFVG_on and (bar_index - bullFVG_bar) > fvgMaxAge
    bullFVG_on := false
if bearFVG_on and (bar_index - bearFVG_bar) > fvgMaxAge
    bearFVG_on := false

// Price entering FVG (Consequent Encroachment)
bullFVG_CE = (bullFVG_hi + bullFVG_lo) / 2
bearFVG_CE = (bearFVG_hi + bearFVG_lo) / 2
inBullFVG  = bullFVG_on and low <= bullFVG_hi and close >= bullFVG_lo
inBearFVG  = bearFVG_on and high >= bearFVG_lo and close <= bearFVG_hi

// ============================================================================
// 7. LIQUIDITY SWEEP — Grab stops then reverse
//    ICT's "smart money hunts liquidity before moving"
// ============================================================================

var float eqHiLvl  = na
var float eqLoLvl  = na
var bool  eqHiOn   = false
var bool  eqLoOn   = false

// Equal highs/lows (liquidity pools)
if not na(swH) and not na(prevSH)
    tol = prevSH * 0.0005
    if math.abs(swH - prevSH) < tol
        eqHiLvl := math.max(swH, prevSH)
        eqHiOn  := true

if not na(swL) and not na(prevSL)
    tol = prevSL * 0.0005
    if math.abs(swL - prevSL) < tol
        eqLoLvl := math.min(swL, prevSL)
        eqLoOn  := true

// Sweep = wick through then close back
bullSweep  = eqLoOn and low < eqLoLvl and close > eqLoLvl
bearSweep  = eqHiOn and high > eqHiLvl and close < eqHiLvl

// Swing point sweep
swingSweepBull = not na(lastSL) and low < lastSL and close > lastSL
swingSweepBear = not na(lastSH) and high > lastSH and close < lastSH

liqSweptBull = bullSweep or swingSweepBull or asiaRaidLow
liqSweptBear = bearSweep or swingSweepBear or asiaRaidHigh

// Recent sweep (within last few bars)
recentBullSweep = liqSweptBull or liqSweptBull[1] or liqSweptBull[2] or liqSweptBull[3]
recentBearSweep = liqSweptBear or liqSweptBear[1] or liqSweptBear[2] or liqSweptBear[3]

if bullSweep
    eqLoOn := false
if bearSweep
    eqHiOn := false

// ============================================================================
// 8. OPTIMAL TRADE ENTRY — Fib 62-79% retracement
//    ICT's sniper entry zone
// ============================================================================

var bool inOTE_bull = false
var bool inOTE_bear = false

if not na(lastSH) and not na(lastSL) and lastSH > lastSL
    if trend == 1
        fib62 = lastSH - (lastSH - lastSL) * oteFibLo
        fib79 = lastSH - (lastSH - lastSL) * oteFibHi
        inOTE_bull := close <= fib62 and close >= fib79
        inOTE_bear := false
    else
        fib62 = lastSL + (lastSH - lastSL) * oteFibLo
        fib79 = lastSL + (lastSH - lastSL) * oteFibHi
        inOTE_bear := close >= fib62 and close <= fib79
        inOTE_bull := false
else
    inOTE_bull := false
    inOTE_bear := false

// ============================================================================
// 9. PREMIUM / DISCOUNT — Only buy in discount, sell in premium
//    ICT's institutional pricing model
// ============================================================================

pdHi       = ta.highest(high, 30)
pdLo       = ta.lowest(low, 30)
equilibrium = (pdHi + pdLo) / 2
inDiscount  = close < equilibrium
inPremium   = close > equilibrium

// ============================================================================
// 10. BREAKER BLOCKS — Failed OB that flips role
// ============================================================================

var float bullBrk_hi = na
var float bullBrk_lo = na
var bool  bullBrk_on = false
var float bearBrk_hi = na
var float bearBrk_lo = na
var bool  bearBrk_on = false

if bearOB_on[1] and not bearOB_on and high > bearOB_hi[1]
    bullBrk_hi := bearOB_hi[1]
    bullBrk_lo := bearOB_lo[1]
    bullBrk_on := true

if bullOB_on[1] and not bullOB_on and low < bullOB_lo[1]
    bearBrk_hi := bullOB_hi[1]
    bearBrk_lo := bullOB_lo[1]
    bearBrk_on := true

inBullBrk = bullBrk_on and low <= bullBrk_hi and close >= bullBrk_lo
inBearBrk = bearBrk_on and high >= bearBrk_lo and close <= bearBrk_hi

if bullBrk_on and close < bullBrk_lo
    bullBrk_on := false
if bearBrk_on and close > bearBrk_hi
    bearBrk_on := false

// ============================================================================
// 11. HIGHER TIMEFRAME BIAS — Trade with the HTF flow
//    ICT always starts from HTF down to LTF
// ============================================================================

htfClose = request.security(syminfo.tickerid, htfTF, close)
htfOpen  = request.security(syminfo.tickerid, htfTF, open)
htfHigh  = request.security(syminfo.tickerid, htfTF, high)
htfLow   = request.security(syminfo.tickerid, htfTF, low)

// HTF structure: simple but effective — is HTF candle bullish or bearish?
htfBull = htfClose > htfOpen
htfBear = htfClose < htfOpen

// HTF displacement on 15m
htfATR    = request.security(syminfo.tickerid, htfTF, ta.atr(14))
htfBody   = math.abs(htfClose - htfOpen)
htfBullDisp = htfBull and htfBody > htfATR * 1.2
htfBearDisp = htfBear and htfBody > htfATR * 1.2

// ============================================================================
// 12. ICT POWER OF 3 (AMD) — Accumulation > Manipulation > Distribution
//    Detect the manipulation phase (Judas swing) then enter distribution
// ============================================================================

// AMD on kill zone level:
// During early KZ = accumulation (tight range)
// Manipulation = sweep of accumulation range
// Distribution = real move after sweep + MSS

// We detect this via: Asian range sets accumulation,
// KZ sweep of Asian range = manipulation, MSS after = distribution entry
amdBull = asiaRaidLow and recentBullMSS   // Swept Asia lows + bullish MSS = buy the distribution
amdBear = asiaRaidHigh and recentBearMSS  // Swept Asia highs + bearish MSS = sell the distribution

// ============================================================================
// 13. CONFLUENCE SCORING — Only take the best setups
// ============================================================================

var int bullC = 0
var int bearC = 0
bullC := 0
bearC := 0

// +1 Trend / Market Structure alignment
if trend == 1
    bullC += 1
if trend == -1
    bearC += 1

// +1 Recent MSS (Market Structure Shift)
if recentBullMSS
    bullC += 1
if recentBearMSS
    bearC += 1

// +1 In Order Block or Breaker Block (institutional entry point)
if inBullOB or inBullBrk
    bullC += 1
if inBearOB or inBearBrk
    bearC += 1

// +1 In Fair Value Gap (imbalance fill)
if inBullFVG
    bullC += 1
if inBearFVG
    bearC += 1

// +1 Liquidity was swept (stops hunted)
if recentBullSweep
    bullC += 1
if recentBearSweep
    bearC += 1

// +1 In OTE zone (sniper entry)
if inOTE_bull
    bullC += 1
if inOTE_bear
    bearC += 1

// +1 Premium/Discount alignment
if inDiscount and trend == 1
    bullC += 1
if inPremium and trend == -1
    bearC += 1

// +1 HTF Bias alignment
if htfBull or htfBullDisp
    bullC += 1
if htfBear or htfBearDisp
    bearC += 1

// ============================================================================
// 14. DAILY TRADE LIMITER
// ============================================================================

var int dayTrades = 0
if ta.change(time("D")) != 0
    dayTrades := 0
canGo = dayTrades < maxDaily

// ============================================================================
// 15. ENTRY CONDITIONS — Maximum confluence required
// ============================================================================

goLong  = bullC >= minScore and kzOK and canGo and strategy.position_size == 0 and recentBullDisp
goShort = bearC >= minScore and kzOK and canGo and strategy.position_size == 0 and recentBearDisp

// ============================================================================
// 16. STOP LOSS & TAKE PROFIT — Tight SL behind sweep/OB
// ============================================================================

var float sl_long  = na
var float tp_long  = na
var float sl_short = na
var float tp_short = na
var float entryPx  = na
var int   entryBar = 0

if goLong
    // SL behind the OB low or FVG low or swing low
    ref = bullOB_on ? bullOB_lo : bullFVG_on ? bullFVG_lo : lastSL
    ref := na(ref) ? close - atr * 2 : ref
    sl_long  := ref - atr * slBuff
    dist     = close - sl_long
    tp_long  := close + dist * rr
    entryPx  := close
    entryBar := bar_index

if goShort
    ref = bearOB_on ? bearOB_hi : bearFVG_on ? bearFVG_hi : lastSH
    ref := na(ref) ? close + atr * 2 : ref
    sl_short := ref + atr * slBuff
    dist     = sl_short - close
    tp_short := close - dist * rr
    entryPx  := close
    entryBar := bar_index

// ============================================================================
// 17. BREAK-EVEN LOGIC — Lock in profit at 1R
// ============================================================================

if useBE and strategy.position_size > 0 and not na(entryPx) and not na(sl_long)
    oneR = entryPx + (entryPx - sl_long)
    if high >= oneR
        sl_long := entryPx + atr * 0.05  // Slightly above entry to cover spread

if useBE and strategy.position_size < 0 and not na(entryPx) and not na(sl_short)
    oneR = entryPx - (sl_short - entryPx)
    if low <= oneR
        sl_short := entryPx - atr * 0.05

// ============================================================================
// 18. TIME-BASED EXIT — Don't hold 1m trades forever
// ============================================================================

timedExitLong  = strategy.position_size > 0 and (bar_index - entryBar) >= maxBarsInTrade
timedExitShort = strategy.position_size < 0 and (bar_index - entryBar) >= maxBarsInTrade

// ============================================================================
// 19. EXECUTION — Autonomous, no alerts needed
// ============================================================================

if goLong
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", stop=sl_long, limit=tp_long)
    dayTrades += 1

if goShort
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", stop=sl_short, limit=tp_short)
    dayTrades += 1

// Update exits dynamically (for break-even SL movement)
if strategy.position_size > 0 and not goLong
    strategy.exit("LX", "L", stop=sl_long, limit=tp_long)

if strategy.position_size < 0 and not goShort
    strategy.exit("SX", "S", stop=sl_short, limit=tp_short)

// Emergency exits
if strategy.position_size > 0 and bearMSS
    strategy.close("L", comment="MSS Exit")

if strategy.position_size < 0 and bullMSS
    strategy.close("S", comment="MSS Exit")

// Time exit
if timedExitLong
    strategy.close("L", comment="Time Exit")

if timedExitShort
    strategy.close("S", comment="Time Exit")
